{
  "name": "@bogdanrn/yt-embed",
  "version": "0.2.0",
  "description": "Promise-wrapped YouTube IFrame Player API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Bogdan Radu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogdanrn/yt-embed.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "postgenerate": "tsx scripts/inject-readme.ts",
    "prebuild": "pnpm generate",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "test:typecheck": "vitest --typecheck --run --project unit",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs-site",
    "docs:site": "pnpm docs:api && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "docs:build": "pnpm docs:api",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,md}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "peerDependencies": {
    "@types/youtube": "^0.2.0",
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@types/youtube": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.2.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.55.5",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "vue": "^3.5.33"
  }
}
